{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openailcap.dev/schemas/app-spec/1.0.0",
  "title": "OpenAILCAP AppSpec",
  "description": "Versioned canonical application intermediate representation shared by designers, agents, compilers and runtime. Schema validation alone does not prove executable correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "dataModels",
    "ui",
    "forms",
    "logic",
    "workflows",
    "security",
    "i18n",
    "deployment"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "dataModels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataModel"
      }
    },
    "ui": {
      "type": "object",
      "required": [
        "pages"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "theme": {
          "type": "object"
        },
        "navigation": {
          "type": "array"
        },
        "assets": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/form"
      }
    },
    "logic": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      }
    },
    "security": {
      "type": "object",
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cryptoRequired": {
          "type": "boolean"
        },
        "auditRequired": {
          "type": "boolean"
        },
        "policies": {
          "type": "array"
        },
        "tenant": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "i18n": {
      "type": "object",
      "required": [
        "locales"
      ],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "defaultLocale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": [
        "status",
        "environments"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-deployed",
            "draft",
            "ready",
            "deployed",
            "failed"
          ]
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactPolicy": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "appId",
        "name",
        "description",
        "version",
        "status"
      ],
      "properties": {
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "published",
            "archived"
          ]
        },
        "tenantId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "concurrency": {
          "type": "string"
        },
        "modules": {
          "type": "string"
        },
        "cryptoRequired": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "text",
            "int",
            "integer",
            "decimal",
            "float",
            "boolean",
            "date",
            "datetime",
            "time",
            "json",
            "enum",
            "uuid",
            "binary"
          ]
        },
        "pk": {
          "type": "boolean"
        },
        "req": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "len": {
          "type": "integer",
          "minimum": 1
        },
        "prec": {
          "type": "string"
        },
        "encrypt": {
          "type": "boolean"
        },
        "ref": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "index": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "dataModel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "display",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "appId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "indexes": {
          "type": "array"
        },
        "constraints": {
          "type": "array"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "formId": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "layout": {
          "type": "object"
        },
        "components": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "form": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "appId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "field",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "req": {
                "type": "boolean"
              },
              "span": {
                "type": "integer"
              },
              "rules": {
                "type": "array"
              },
              "encrypted": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "graph": {
      "type": "object",
      "required": [
        "id",
        "name",
        "nodes",
        "edges"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "appId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "f",
              "t"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "f": {
                "type": "string"
              },
              "t": {
                "type": "string"
              },
              "when": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
